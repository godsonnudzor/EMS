# Frontend environment variables for Vite
#
# Copy this file to `.env` (or create `.env.local`) and edit values for your environment.
# Vite requires client-side variables to start with `VITE_`.

# Base URL for backend API used by the frontend (example for local development)
VITE_API_URL=http://localhost:5000

# Example: if your backend runs on a different port, change the value above.
# After changing `.env`, restart the dev server (`npm run dev`) so Vite picks up the new values.
